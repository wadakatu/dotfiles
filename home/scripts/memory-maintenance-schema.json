{
  "type": "object",
  "additionalProperties": false,
  "required": ["changes", "proposals", "needs_human"],
  "properties": {
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dir", "file", "action", "evidence"],
        "properties": {
          "dir": { "type": "string" },
          "file": { "type": "string" },
          "action": { "enum": ["update", "create", "delete", "merge", "move", "index-only"] },
          "into": { "type": "string" },
          "index_line": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_dir", "source_file", "source_name", "kind", "target_repo", "target_path",
          "new_content", "title", "body", "commit_message", "after_merge", "confidence", "public_safe"
        ],
        "properties": {
          "source_dir": { "type": "string" },
          "source_file": { "type": "string" },
          "source_name": { "type": "string" },
          "kind": { "enum": ["global", "repo-rules"] },
          "target_repo": { "type": "string" },
          "target_path": { "type": "string" },
          "new_content": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "commit_message": { "type": "string" },
          "after_merge": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "delete": { "type": "boolean" },
              "content": { "type": "string" }
            }
          },
          "confidence": { "enum": ["高", "中", "低"] },
          "public_safe": { "type": "boolean" }
        }
      }
    },
    "needs_human": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dir", "file", "question"],
        "properties": {
          "dir": { "type": "string" },
          "file": { "type": "string" },
          "question": { "type": "string" }
        }
      }
    }
  }
}
